# Shared template: copy to nova-build.env, edit it, then source it in Bash.
# nova-build.env is ignored by Git; keep personal paths out of this template.
# Sourcing reapplies these values; CLI options and subsequent exports override
# them. No build starts and the caller's working directory/PATH are unchanged.

# Paths default to this checkout plus a sibling kernel source checkout.
# You may replace any path below with your own quoted absolute path.
export NOVA_BUILD_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
export NOVA_SOURCE="${NOVA_BUILD_ROOT}/../nova-core"
export NOVA_BUILD_DIR="${NOVA_BUILD_ROOT}/build"
# Optional private seed: copy configs/nova-kvm.config to configs/my-host.config,
# review it for your host, then point NOVA_CONFIG at that copy.
export NOVA_CONFIG="${NOVA_BUILD_ROOT}/configs/nova-kvm.config"
export NOVA_TOOLCHAIN="${NOVA_BUILD_ROOT}/toolchains/llvm-22.1.8-rust-1.97.0-x86_64"
export NOVA_PYTHON="python3.13"             # Installed Python >= 3.9; also Kbuild PYTHON3
export NOVA_JOBS="20"                      # Adjust parallel jobs for your machine
export NOVA_KIND="kernel"                  # kernel or module
export NOVA_ALLOW_DIRTY="0"                # 1 permits tracked, uncommitted edits

export NOVA_TAG=""                         # Empty: UTC YYYYMMDD-HHMMSS per invocation
export NOVA_OUTPUT=""                      # Empty: <build-dir>/artifacts/nova[-vf]-<tag>.tar.gz
export NOVA_LOCALVERSION=""                # Empty: unique commit/time kernel suffix
export NOVA_CLONE_REF="zhi/nova-vgpu-wip"   # Used only when NOVA_SOURCE does not exist

# NOVA_CONFIG is the seed; ${NOVA_BUILD_DIR}/.config is the working config.
# It seeds only a new full-kernel build; existing .config is reused.
# Module mode preserves the baseline and ignores NOVA_CONFIG/NOVA_LOCALVERSION.
# NOVA_BUILD_DIR is the actual Kbuild O= directory; NOVA_TAG never changes it.
